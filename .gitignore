# Build
bin/
obj/
out/
*.user
*.suo
.vs/
.idea/

# Node / Angular
node_modules/
dist/
.angular/

# Local config and secrets
.env
*.pfx
*.p12
*.key
!docs/**/*.key
certs/
softhsm/

# Runtime data
data/
*.log

# Solution
*.slnx.user
TestResults/
*.trx

# Local edge material
certs/
.env

# Certificate authority material
ca/

# The published revocation list and anything else the API writes for the
# outside world. Regenerated on a schedule; a committed one is a stale one.
pki/

# Lab agent identity: a private key, never in the repo.
.lab/

# Build output: a 67 MB MSI does not belong in git history.
artifacts/

# What the console offers for download, written by scripts/build-downloads.sh
# from artifacts/ and copied to the server. Build output too.
downloads/

# Worktrees for parallel work. A worktree is not content: committed, it lands
# as an embedded repository that no clone can resolve.
.worktrees/

# Written by scripts/set-directory.sh for one installation
docker-compose.directory.yml
.env.before-directory.*

# The other CA backend's settings, kept beside .env on a lab server so it can
# be swapped in. It holds the same secrets .env does, and was the one file
# `git clean` on BY-CACMS would have deleted.
.env.*
!.env.example
