<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0-windows so that Blinky.AdcsConnector is reachable from here. A
         net10.0 test project cannot reference it, the connector targets Windows
         because ICertRequest3 is DCOM, and leaving it untested was the
         alternative. Little is lost: the solution already builds on Windows
         only - Blinky.Agent.Ui is WPF - and CI runs windows-latest. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Blinky.Contracts\Blinky.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Blinky.Domain\Blinky.Domain.csproj" />
    <ProjectReference Include="..\..\src\Blinky.Piv\Blinky.Piv.csproj" />
    <ProjectReference Include="..\..\src\Blinky.Infrastructure\Blinky.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Blinky.Api\Blinky.Api.csproj" />
    <ProjectReference Include="..\..\src\Blinky.Directory\Blinky.Directory.csproj" />
    <ProjectReference Include="..\..\src\Blinky.Passkeys\Blinky.Passkeys.csproj" />
    <ProjectReference Include="..\..\src\Blinky.Pki\Blinky.Pki.csproj" />
    <ProjectReference Include="..\..\src\Blinky.Secrets\Blinky.Secrets.csproj" />
    <ProjectReference Include="..\..\src\Blinky.Agent.Service\Blinky.Agent.Service.csproj" />
    <ProjectReference Include="..\..\src\Blinky.AdcsConnector\Blinky.AdcsConnector.csproj" />
    <ProjectReference Include="..\..\tools\PaletteTool\PaletteTool.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\docker\postgres\001-schema.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>