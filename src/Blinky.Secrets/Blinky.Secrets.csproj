<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      PKCS#11 rather than a vendor SDK. The point of this project is that the
      device is a configuration value: SoftHSM2 and a YubiHSM differ by a module
      path and a slot, and nothing above this line is allowed to know which one
      answered. Pkcs11Interop is a P/Invoke surface over the standard, not an
      abstraction over devices - which is exactly what is wanted here, because
      the abstraction is IKeyProvider and it belongs to this repository.
    -->
    <PackageReference Include="Pkcs11Interop" />
  </ItemGroup>

</Project>
