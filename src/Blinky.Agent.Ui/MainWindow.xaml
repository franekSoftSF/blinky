<Window x:Class="Blinky.Agent.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Blinky.Agent.Ui"
        Title="Blinky" Width="480" SizeToContent="Height"
        Icon="Assets/blinky-agent.ico"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="True"
        Background="{DynamicResource Background}"
        Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI"
        FontSize="15"
        Visibility="Hidden">

    <!-- The window the service raises on its own, for a prompt that belongs to
         no job - a PIN at sign-in. During a job the prompt is shown inside the
         issuance window instead (0084a). The mark is on it because a box that
         appears unasked and wants a PIN has to look like the product the
         person knows, not like something that could be anybody's. -->
    <DockPanel Margin="28">
        <Image DockPanel.Dock="Left" Source="Assets/blinky-agent-256.png" Width="32" Height="32"
               Margin="0,0,14,0" VerticalAlignment="Top"
               RenderOptions.BitmapScalingMode="HighQuality" />
        <local:PromptPanel x:Name="Prompt" />
    </DockPanel>
</Window>
