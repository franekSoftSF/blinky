<Window x:Class="Blinky.Agent.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blinky" Width="480" SizeToContent="Height"
        Icon="Assets/blinky-agent.ico"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="True"
        Background="{DynamicResource Background}"
        Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI"
        FontSize="15"
        Visibility="Hidden">

    <!-- The window the service raises on its own. The mark is on it because a
         box that appears unasked and wants a PIN has to look like the product
         the person knows, not like something that could be anybody's. -->
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <Image DockPanel.Dock="Left" Source="Assets/blinky-agent-256.png" Width="32" Height="32"
                   Margin="0,0,12,0" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock x:Name="TitleText" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"
                       VerticalAlignment="Center" Text="Blinky" />
        </DockPanel>

        <TextBlock x:Name="MessageText" Grid.Row="1" TextWrapping="Wrap"
                   Margin="0,12,0,20" Foreground="{DynamicResource TextMuted}" />

        <PasswordBox x:Name="PinBox" Grid.Row="2" FontSize="20" Padding="10,8"
                     MaxLength="8" KeyDown="PinBox_KeyDown" />

        <!-- A palette role, not the #B00020 it was: that red was the one
             colour in this project no theme could reach, and on the dark
             background it was all but unreadable. -->
        <TextBlock x:Name="AttemptsText" Grid.Row="3" Margin="0,10,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource Danger}" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="CancelButton" MinWidth="120" Padding="12,8" Margin="0,0,12,0"
                    Click="Cancel_Click" IsCancel="True" />
            <Button x:Name="OkButton" Style="{StaticResource Primary}" MinWidth="140" Padding="12,8"
                    Click="Ok_Click" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
