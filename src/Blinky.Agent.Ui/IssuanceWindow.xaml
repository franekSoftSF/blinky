<Window x:Class="Blinky.Agent.Ui.IssuanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Blinky.Agent.Ui"
        Title="Blinky" Width="860" Height="600" MinWidth="720" MinHeight="520"
        Icon="Assets/blinky-agent.ico"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        Background="{DynamicResource Background}"
        Foreground="{DynamicResource Text}"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="Segoe UI"
        FontSize="14">

    <!-- 0084a. Opened when a job that needs the person starts, and the only
         place its prompts appear: what is happening, for whom, started by
         whom, which step, and what to do now. A PIN request that arrives on
         its own trains people to type their PIN into whatever asks; one that
         arrives inside this window, at a step the list already showed coming,
         does not. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- What and for whom -->
        <Border Grid.Row="0" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Divider}"
                BorderThickness="0,0,0,1" Padding="20,14">
            <DockPanel>
                <Image DockPanel.Dock="Left" Source="Assets/blinky-agent-256.png" Width="40" Height="40"
                       Margin="0,0,14,0" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="OperationText" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="ContextText" Style="{StaticResource Hint}" FontSize="13" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- The steps -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource CardTitle}"
                               Text="{Binding Path=[Issue.Steps], Source={x:Static local:Strings.Current}}" />
                    <ProgressBar x:Name="Progress" DockPanel.Dock="Top" Margin="0,0,0,16" Maximum="1" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="StepList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- A mark as well as a colour: done, now, still to come. -->
                                    <DockPanel Margin="0,0,0,10">
                                        <Border DockPanel.Dock="Left" Width="24" Height="24" CornerRadius="12"
                                                Margin="0,0,12,0" VerticalAlignment="Top"
                                                Background="{Binding RingFill}" BorderBrush="{Binding RingBrush}"
                                                BorderThickness="1.5">
                                            <TextBlock Text="{Binding Mark}" FontFamily="{StaticResource Icons}" FontSize="11"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{Binding MarkBrush}" />
                                        </Border>
                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" VerticalAlignment="Center"
                                                   FontWeight="{Binding Weight}" Foreground="{Binding TextBrush}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Now -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="24">
                <Grid>
                    <!-- While the job runs: the step, what to do, and any prompt. -->
                    <ScrollViewer x:Name="RunningPanel" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Hint}" FontSize="13"
                                       Text="{Binding Path=[Issue.Now], Source={x:Static local:Strings.Current}}" />
                            <DockPanel Margin="0,6,0,0">
                                <TextBlock x:Name="StepIcon" DockPanel.Dock="Left" FontFamily="{StaticResource Icons}"
                                           FontSize="26" Margin="0,2,14,0" VerticalAlignment="Top"
                                           Foreground="{DynamicResource AccentText}" />
                                <StackPanel>
                                    <TextBlock x:Name="StepTitle" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock x:Name="StepHint" FontSize="15" TextWrapping="Wrap" Margin="0,8,0,0"
                                               Foreground="{DynamicResource TextMuted}" />
                                </StackPanel>
                            </DockPanel>

                            <Border x:Name="PromptCard" Visibility="Collapsed" Margin="0,24,0,0" Padding="18"
                                    CornerRadius="{StaticResource Radius}"
                                    Background="{DynamicResource Background}"
                                    BorderBrush="{DynamicResource Accent}" BorderThickness="1.5">
                                <local:PromptPanel x:Name="Prompt" InsideJob="True" />
                            </Border>

                            <TextBlock Style="{StaticResource Hint}" FontSize="13" Margin="0,24,0,0"
                                       Text="{Binding Path=[Issue.KeepKey], Source={x:Static local:Strings.Current}}" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- When it has ended: what happened, and the one thing to do next. -->
                    <StackPanel x:Name="EndPanel" Visibility="Collapsed" VerticalAlignment="Center">
                        <Border x:Name="EndRing" Width="56" Height="56" CornerRadius="28" BorderThickness="2.5"
                                HorizontalAlignment="Left" Background="{DynamicResource Panel}">
                            <TextBlock x:Name="EndMark" FontFamily="{StaticResource Icons}" FontSize="24"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="EndTitle" FontSize="22" FontWeight="SemiBold" Margin="0,16,0,0" TextWrapping="Wrap" />
                        <TextBlock x:Name="EndText" FontSize="15" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextMuted}" />
                        <TextBlock x:Name="EndDetail" Margin="0,12,0,0" TextWrapping="Wrap" FontSize="12"
                                   FontFamily="{StaticResource Mono}" Foreground="{DynamicResource TextMuted}" />
                        <Button Style="{StaticResource Primary}" HorizontalAlignment="Left" MinWidth="140"
                                Margin="0,24,0,0" Click="Close_Click"
                                Content="{Binding Path=[Tokens.Close], Source={x:Static local:Strings.Current}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
