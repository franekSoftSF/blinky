<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Generated by tools/PaletteTool from Palette.cs. Do not edit by hand;
         run that tool again instead. CLAUDE.md has the command. -->

    <!-- The tray UI and the web console are the same product, so they are
         the same colours: this dictionary and frontend/src/tokens.scss come
         out of one Palette.cs. Both dictionaries define exactly the same
         keys - a key present in one and missing from the other is a XAML
         error that only appears after somebody switches theme, which is the
         worst time to find it. -->

    <Color x:Key="BackgroundColour">#07101E</Color>
    <SolidColorBrush x:Key="Background" Color="{StaticResource BackgroundColour}" />
    <SolidColorBrush x:Key="Panel" Color="#0D192B" />
    <SolidColorBrush x:Key="PanelRaised" Color="#0E1C30" />
    <SolidColorBrush x:Key="Divider" Color="#1C2C44" />
    <SolidColorBrush x:Key="Text" Color="#EAF2FF" />
    <SolidColorBrush x:Key="TextMuted" Color="#93A3B8" />
    <SolidColorBrush x:Key="TextFaint" Color="#8294AB" />
    <SolidColorBrush x:Key="Accent" Color="#18C9DF" />
    <SolidColorBrush x:Key="AccentText" Color="#35D6E8" />
    <SolidColorBrush x:Key="AccentSoft" Color="#102F40" />
    <SolidColorBrush x:Key="OnAccent" Color="#03131B" />
    <SolidColorBrush x:Key="Warning" Color="#FFD477" />
    <SolidColorBrush x:Key="WarningSoft" Color="#40351E" />
    <SolidColorBrush x:Key="Danger" Color="#FF8993" />
    <SolidColorBrush x:Key="Managed" Color="#55DFAD" />
    <SolidColorBrush x:Key="ManagedSoft" Color="#153B34" />
    <SolidColorBrush x:Key="FieldBackground" Color="#0B1626" />

</ResourceDictionary>
