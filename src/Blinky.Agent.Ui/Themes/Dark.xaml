<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Generated by tools/PaletteTool from Palette.cs. Do not edit by hand;
         run that tool again instead. CLAUDE.md has the command. -->

    <!-- The tray UI and the web console are the same product, so they are
         the same colours: this dictionary and frontend/src/tokens.scss come
         out of one Palette.cs. Both dictionaries define exactly the same
         keys - a key present in one and missing from the other is a XAML
         error that only appears after somebody switches theme, which is the
         worst time to find it. -->

    <Color x:Key="BackgroundColour">#1A1A1A</Color>
    <SolidColorBrush x:Key="Background" Color="{StaticResource BackgroundColour}" />
    <SolidColorBrush x:Key="Panel" Color="#242424" />
    <SolidColorBrush x:Key="PanelRaised" Color="#2A2A2A" />
    <SolidColorBrush x:Key="Divider" Color="#3D3D3D" />
    <SolidColorBrush x:Key="Text" Color="#F2F2F2" />
    <SolidColorBrush x:Key="TextMuted" Color="#B4B4B4" />
    <SolidColorBrush x:Key="TextFaint" Color="#A3A3A3" />
    <SolidColorBrush x:Key="Accent" Color="#18C9DF" />
    <SolidColorBrush x:Key="AccentText" Color="#35D6E8" />
    <SolidColorBrush x:Key="AccentSoft" Color="#173A40" />
    <SolidColorBrush x:Key="OnAccent" Color="#03131B" />
    <SolidColorBrush x:Key="Warning" Color="#F0B429" />
    <SolidColorBrush x:Key="WarningSoft" Color="#3A3020" />
    <SolidColorBrush x:Key="Danger" Color="#FF8A85" />
    <SolidColorBrush x:Key="Managed" Color="#55DFAD" />
    <SolidColorBrush x:Key="ManagedSoft" Color="#1D3A30" />
    <SolidColorBrush x:Key="FieldBackground" Color="#1A1A1A" />

</ResourceDictionary>
