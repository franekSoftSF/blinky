<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Generated by tools/PaletteTool from Palette.cs. Do not edit by hand;
         run that tool again instead. CLAUDE.md has the command. -->

    <!-- The tray UI and the web console are the same product, so they are
         the same colours: this dictionary and frontend/src/tokens.scss come
         out of one Palette.cs. Both dictionaries define exactly the same
         keys - a key present in one and missing from the other is a XAML
         error that only appears after somebody switches theme, which is the
         worst time to find it. -->

    <Color x:Key="BackgroundColour">#EEF3F8</Color>
    <SolidColorBrush x:Key="Background" Color="{StaticResource BackgroundColour}" />
    <SolidColorBrush x:Key="Panel" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PanelRaised" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Divider" Color="#D8E1EB" />
    <SolidColorBrush x:Key="Text" Color="#142238" />
    <SolidColorBrush x:Key="TextMuted" Color="#566A80" />
    <SolidColorBrush x:Key="TextFaint" Color="#5A6D82" />
    <SolidColorBrush x:Key="Accent" Color="#087D8C" />
    <SolidColorBrush x:Key="AccentText" Color="#05606C" />
    <SolidColorBrush x:Key="AccentSoft" Color="#DDF2F5" />
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Warning" Color="#6C4B00" />
    <SolidColorBrush x:Key="WarningSoft" Color="#FFF0C7" />
    <SolidColorBrush x:Key="Danger" Color="#A32036" />
    <SolidColorBrush x:Key="Managed" Color="#0F6B48" />
    <SolidColorBrush x:Key="ManagedSoft" Color="#D9F6E7" />
    <SolidColorBrush x:Key="FieldBackground" Color="#FFFFFF" />

</ResourceDictionary>
