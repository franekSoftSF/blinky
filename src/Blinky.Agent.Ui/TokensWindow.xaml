<Window x:Class="Blinky.Agent.Ui.TokensWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Blinky.Agent.Ui"
        Title="Blinky" Height="640" Width="1020" MinHeight="520" MinWidth="880"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        Background="{DynamicResource Background}"
        Foreground="{DynamicResource Text}"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Flat, themed buttons. The stock chrome is grey-on-grey in a dark
             window and unreadable at the exact moment somebody is looking for
             the button that unblocks their token. -->
        <Style x:Key="Flat" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PanelRaised}" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{DynamicResource AccentSoft}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Flat}">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
        </Style>

        <!-- One device in the left column. -->
        <DataTemplate x:Key="DeviceTemplate">
            <Border Background="Transparent" Padding="12,10" CornerRadius="8" Margin="0,0,0,4">
                <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                               Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Line2}" FontSize="11" Margin="0,2,0,0"
                               Foreground="{DynamicResource TextMuted}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="290" />
        </Grid.ColumnDefinitions>

        <!-- ============================ devices ============================ -->
        <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Divider}"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="14,16,14,14">
                <TextBlock DockPanel.Dock="Top" FontSize="17" FontWeight="SemiBold"
                           Margin="4,0,0,12"
                           Text="{Binding Path=[Tokens.Title], Source={x:Static local:Strings.Current}}" />

                <Button DockPanel.Dock="Bottom" Style="{StaticResource Flat}" Margin="0,10,0,0"
                        Click="Refresh_Click"
                        Content="{Binding Path=[Tokens.Refresh], Source={x:Static local:Strings.Current}}" />

                <ListBox x:Name="DeviceList" Background="Transparent" BorderThickness="0"
                         ItemTemplate="{StaticResource DeviceTemplate}"
                         HorizontalContentAlignment="Stretch"
                         SelectionChanged="Device_Changed">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Row" CornerRadius="8"
                                                Background="Transparent">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background"
                                                        Value="{DynamicResource PanelRaised}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Row" Property="Background"
                                                        Value="{DynamicResource AccentSoft}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- =========================== the slots =========================== -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="28,20,28,20">
            <StackPanel>
                <TextBlock x:Name="HeaderText" FontSize="26" FontWeight="Light"
                           Foreground="{DynamicResource Accent}" />
                <TextBlock x:Name="SubHeaderText" FontSize="12" Margin="0,2,0,16"
                           Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />

                <!-- Everything still at its factory value, in one banner. -->
                <Border x:Name="DefaultsBanner" CornerRadius="8" Padding="14,12" Margin="0,0,0,18"
                        Background="{DynamicResource WarningSoft}"
                        BorderBrush="{DynamicResource Warning}" BorderThickness="1"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="DefaultsText" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Text}" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="EmptyText" TextWrapping="Wrap" Visibility="Collapsed"
                           Foreground="{DynamicResource TextMuted}" />

                <ItemsControl x:Name="SlotList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Panel}" CornerRadius="10"
                                    Padding="16,14" Margin="0,0,0,10"
                                    BorderBrush="{DynamicResource Divider}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="34" Height="34" CornerRadius="17"
                                            VerticalAlignment="Top"
                                            Background="{DynamicResource AccentSoft}">
                                        <TextBlock Text="{Binding SlotId}" FontSize="12"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Accent}" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="4,0,12,0">
                                        <TextBlock Text="{Binding SlotName}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Text}" />
                                        <TextBlock Text="{Binding Subject}" Margin="0,3,0,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextMuted}" />
                                        <TextBlock Text="{Binding Detail}" FontSize="11"
                                                   Margin="0,3,0,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFaint}" />
                                    </StackPanel>

                                    <!-- Managed, unmanaged, or unknown. Never a
                                         blank where the third one belongs. -->
                                    <Border Grid.Column="2" VerticalAlignment="Top"
                                            CornerRadius="10" Padding="10,4"
                                            Background="{Binding BadgeBackground}"
                                            Visibility="{Binding BadgeVisibility}">
                                        <TextBlock Text="{Binding BadgeText}" FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding BadgeForeground}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- ========================== management =========================== -->
        <Border Grid.Column="2" Background="{DynamicResource Panel}"
                BorderBrush="{DynamicResource Divider}" BorderThickness="1,0,0,0">
            <StackPanel x:Name="ManagementPanel" Margin="18,20,18,18">
                <TextBlock FontSize="11" FontWeight="SemiBold" Margin="0,0,0,14"
                           Foreground="{DynamicResource TextMuted}"
                           Text="{Binding Path=[Manage.Title], Source={x:Static local:Strings.Current}}" />

                <Button x:Name="ChangePinButton" Style="{StaticResource Flat}"
                        HorizontalContentAlignment="Stretch" Margin="0,0,0,8"
                        Click="ChangePin_Click">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold"
                                   Text="{Binding Path=[Tokens.ChangePin], Source={x:Static local:Strings.Current}}" />
                        <TextBlock x:Name="PinStateText" FontSize="11" Margin="0,3,0,0"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" />
                    </StackPanel>
                </Button>

                <Button x:Name="OfflineButton" Style="{StaticResource Flat}"
                        HorizontalContentAlignment="Stretch" Margin="0,0,0,8"
                        Click="UnblockOffline_Click">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold"
                                   Text="{Binding Path=[Manage.Offline], Source={x:Static local:Strings.Current}}" />
                        <TextBlock x:Name="OfflineStateText" FontSize="11" Margin="0,3,0,0"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" />
                    </StackPanel>
                </Button>

                <!-- No "change PUK" here. A PUK somebody chooses is a PUK
                     that is written down and the same across a drawer of
                     tokens; letting a person pick a better one is a workaround
                     for the wrong problem. Blinky holds the value, spends it
                     on an unblock and replaces it, and nobody types it. -->

                <Button x:Name="UnblockButton" Style="{StaticResource Flat}"
                        HorizontalContentAlignment="Stretch" Margin="0,0,0,8"
                        Click="Unblock_Click">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold"
                                   Text="{Binding Path=[Tokens.Unblock], Source={x:Static local:Strings.Current}}" />
                        <TextBlock x:Name="UnblockStateText" FontSize="11" Margin="0,3,0,0"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" />
                    </StackPanel>
                </Button>

                <!-- No management key here, deliberately. It is an operator's
                     secret, and nothing in this window can change it: the
                     person at the keyboard would be shown a warning they
                     cannot act on, which is how people learn to dismiss
                     warnings. It belongs in the console, and rotating it is
                     patch 0025. -->

                <TextBlock x:Name="StatusText" FontSize="11" Margin="0,14,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFaint}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
