<Window x:Class="Blinky.Agent.Ui.TokensWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Blinky.Agent.Ui"
        Title="Blinky" Height="560" Width="720"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"
                   Text="{Binding Path=[Tokens.Title], Source={x:Static local:Strings.Current}}" />

        <TextBlock x:Name="EmptyText" Grid.Row="1" TextWrapping="Wrap"
                   VerticalAlignment="Top" Visibility="Collapsed" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="TokenList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="4"
                                Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock FontSize="15" FontWeight="SemiBold"
                                           Text="{Binding Heading}" />
                                <TextBlock Opacity="0.7" Margin="0,2,0,0"
                                           Text="{Binding SubHeading}" />

                                <TextBlock Foreground="#B00020" Margin="0,6,0,0"
                                           TextWrapping="Wrap"
                                           Text="{Binding Warning}"
                                           Visibility="{Binding WarningVisibility}" />

                                <ItemsControl ItemsSource="{Binding Slots}" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock FontFamily="Consolas" FontSize="13"
                                                           Text="{Binding SlotId}"
                                                           VerticalAlignment="Top" />

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Line1}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Line2}"
                                                               Opacity="0.7" FontSize="12"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Width="130" Margin="0,0,8,0"
                                            Tag="{Binding Serial}" Click="ChangePin_Click"
                                            Content="{Binding Path=[Tokens.ChangePin],
                                                      Source={x:Static local:Strings.Current}}" />
                                    <Button Width="130"
                                            Tag="{Binding Serial}" Click="Unblock_Click"
                                            IsEnabled="{Binding HasPuk}"
                                            Content="{Binding Path=[Tokens.Unblock],
                                                      Source={x:Static local:Strings.Current}}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Opacity="0.6"
                       Margin="0,0,16,0" />
            <Button Width="110" Margin="0,0,8,0" Click="Refresh_Click"
                    Content="{Binding Path=[Tokens.Refresh], Source={x:Static local:Strings.Current}}" />
            <Button Width="110" IsCancel="True" Click="Close_Click"
                    Content="{Binding Path=[Tokens.Close], Source={x:Static local:Strings.Current}}" />
        </StackPanel>
    </Grid>
</Window>
