<Window x:Class="Blinky.Agent.Ui.TokensWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Blinky.Agent.Ui"
        Title="Blinky" Height="700" Width="1100" MinHeight="560" MinWidth="940"
        Icon="Assets/blinky-agent.ico"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        Background="{DynamicResource Background}"
        Foreground="{DynamicResource Text}"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="Segoe UI"
        FontSize="14">

    <Window.Resources>
        <!-- One device in the left column. The texts take the item's
             foreground, so a selected row reads in the accent's own text
             colour rather than light grey on cyan. -->
        <DataTemplate x:Key="DeviceTemplate">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="&#xE8CC;" FontFamily="{StaticResource Icons}" FontSize="18"
                           VerticalAlignment="Top" Margin="0,2,12,0"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                    <TextBlock Text="{Binding Line2}" FontSize="12" Margin="0,2,0,0" Opacity="0.8"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />

                    <!-- Only that Blinky manages it. The device name says what
                         the card is; this says whose it is. -->
                    <Border Visibility="{Binding ManagedVisibility}" Margin="0,6,0,0"
                            HorizontalAlignment="Left" CornerRadius="9" Padding="8,2"
                            Background="{DynamicResource ManagedSoft}">
                        <TextBlock FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Managed}"
                                   Text="{Binding Path=[Badge.Managed],
                                          Source={x:Static local:Strings.Current}}" />
                    </Border>
                </StackPanel>
            </DockPanel>
        </DataTemplate>

        <!-- A management action: a title and the state that decides it. -->
        <Style x:Key="Action" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="SlotAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>

    <!-- BlinkyLite's layout: a bar on top, the work in cards, the messages in
         a bar at the bottom - so somebody who has used one finds their way in
         the other. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================ top bar ============================ -->
        <Border Grid.Row="0"
                Background="{DynamicResource Panel}"
                BorderBrush="{DynamicResource Divider}"
                BorderThickness="0,0,0,1"
                Padding="20,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Quiet}" VerticalAlignment="Center"
                        Click="Refresh_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}" FontSize="15"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding Path=[Tokens.Refresh], Source={x:Static local:Strings.Current}}" />
                    </StackPanel>
                </Button>

                <!-- The mark and the wordmark: "Blinky" in the text colour, the
                     product in the accent (brand/README.md). A proper name,
                     not a text to translate. -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/blinky-agent-256.png" Width="40" Height="40"
                           Margin="0,0,12,0" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="20" FontWeight="Bold">
                            <Run Text="Blinky" /><Run Text="CMS" Foreground="{DynamicResource AccentText}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="{Binding Path=[Tokens.Title], Source={x:Static local:Strings.Current}}" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="290" />
            </Grid.ColumnDefinitions>

            <!-- ============================ devices ============================ -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12,16">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource CardTitle}" Margin="8,0,0,10"
                               Text="{Binding Path=[Tokens.Title], Source={x:Static local:Strings.Current}}" />

                    <ListBox x:Name="DeviceList" Background="Transparent" BorderThickness="0" Padding="0"
                             ItemTemplate="{StaticResource DeviceTemplate}"
                             SelectionChanged="Device_Changed" />
                </DockPanel>
            </Border>

            <!-- =========================== the slots =========================== -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,6,0">
                    <TextBlock x:Name="HeaderText" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock x:Name="SubHeaderText" Style="{StaticResource Hint}" FontSize="13" Margin="0,4,0,16" />

                    <!-- Everything still at its factory value, in one banner. -->
                    <Border x:Name="DefaultsBanner" CornerRadius="{StaticResource Radius}" Padding="14,12" Margin="0,0,0,16"
                            Background="{DynamicResource WarningSoft}"
                            BorderBrush="{DynamicResource Warning}" BorderThickness="1"
                            Visibility="Collapsed">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" FontFamily="{StaticResource Icons}" FontSize="16"
                                       Foreground="{DynamicResource Warning}" Margin="0,1,12,0" VerticalAlignment="Top" />
                            <TextBlock x:Name="DefaultsText" TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>

                    <TextBlock x:Name="EmptyText" Style="{StaticResource Hint}" FontSize="13" Visibility="Collapsed" />

                    <ItemsControl x:Name="SlotList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- The slot as BlinkyLite marks a step:
                                             a ring in the accent, the number in it. -->
                                        <Border Width="34" Height="34" CornerRadius="17"
                                                VerticalAlignment="Top" Margin="0,0,14,0"
                                                Background="{DynamicResource Background}"
                                                BorderBrush="{DynamicResource Accent}" BorderThickness="1.5">
                                            <TextBlock Text="{Binding SlotId}" FontSize="12" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource AccentText}" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding SlotName}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Subject}" Margin="0,3,0,0" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextMuted}" />
                                            <TextBlock Text="{Binding Detail}" FontSize="12" Margin="0,3,0,0"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFaint}" />

                                            <!-- What the card demands before it
                                                 will use the private key. Worth a
                                                 line of its own: "nothing" is a
                                                 possible answer. -->
                                            <TextBlock Text="{Binding Protection}" FontSize="12" Margin="0,3,0,0"
                                                       TextWrapping="Wrap"
                                                       Foreground="{Binding ProtectionColour}" />

                                            <!-- Wrapped: three buttons do not fit beside the badge
                                                 in the narrowest window, and the last one was the
                                                 one cut off - delete, the one that has to read. -->
                                            <WrapPanel Margin="0,10,0,-8"
                                                       Visibility="{Binding ActionsVisibility}">
                                                <Button Style="{StaticResource SlotAction}"
                                                        Tag="{Binding SlotId}" Click="Export_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xEDE1;" FontFamily="{StaticResource Icons}" FontSize="12"
                                                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                                                        <TextBlock VerticalAlignment="Center"
                                                                   Text="{Binding Path=[Cert.Export], Source={x:Static local:Strings.Current}}" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource SlotAction}"
                                                        Tag="{Binding SlotId}" Click="Install_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource Icons}" FontSize="12"
                                                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                                                        <TextBlock VerticalAlignment="Center"
                                                                   Text="{Binding Path=[Cert.Install], Source={x:Static local:Strings.Current}}" />
                                                    </StackPanel>
                                                </Button>
                                                <!-- Only where Blinky did not put
                                                     it. Removing a credential
                                                     Blinky issued is a revocation
                                                     and belongs to the server. -->
                                                <Button Style="{StaticResource SlotAction}"
                                                        Foreground="{DynamicResource Danger}"
                                                        Visibility="{Binding DeleteVisibility}"
                                                        Tag="{Binding SlotId}" Click="Delete_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE74D;" FontFamily="{StaticResource Icons}" FontSize="12"
                                                                   VerticalAlignment="Center" Margin="0,0,6,0"
                                                                   Foreground="{DynamicResource Danger}" />
                                                        <TextBlock VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource Danger}"
                                                                   Text="{Binding Path=[Cert.Delete], Source={x:Static local:Strings.Current}}" />
                                                    </StackPanel>
                                                </Button>
                                            </WrapPanel>
                                        </StackPanel>

                                        <!-- Managed, unmanaged, or unknown. Never a
                                             blank where the third one belongs. -->
                                        <Border Grid.Column="2" VerticalAlignment="Top"
                                                CornerRadius="10" Padding="10,4"
                                                Background="{Binding BadgeBackground}"
                                                Visibility="{Binding BadgeVisibility}">
                                            <TextBlock Text="{Binding BadgeText}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{Binding BadgeForeground}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ========================== management =========================== -->
            <!-- Named on the card rather than its contents, so that with no
                 token the whole card goes and not only what is in it. -->
            <Border x:Name="ManagementPanel" Grid.Column="4" Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}"
                               Text="{Binding Path=[Manage.Title], Source={x:Static local:Strings.Current}}" />

                    <Button x:Name="ChangePinButton" Style="{StaticResource Action}" Click="ChangePin_Click">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE192;" FontFamily="{StaticResource Icons}" FontSize="16"
                                       Foreground="{DynamicResource AccentText}" Margin="0,1,12,0" VerticalAlignment="Top" />
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold"
                                           Text="{Binding Path=[Tokens.ChangePin], Source={x:Static local:Strings.Current}}" />
                                <TextBlock x:Name="PinStateText" Style="{StaticResource Hint}" Margin="0,3,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Button>

                    <Button x:Name="OfflineButton" Style="{StaticResource Action}" Click="UnblockOffline_Click">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE717;" FontFamily="{StaticResource Icons}" FontSize="16"
                                       Foreground="{DynamicResource AccentText}" Margin="0,1,12,0" VerticalAlignment="Top" />
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold"
                                           Text="{Binding Path=[Manage.Offline], Source={x:Static local:Strings.Current}}" />
                                <TextBlock x:Name="OfflineStateText" Style="{StaticResource Hint}" Margin="0,3,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Button>

                    <!-- No "change PUK" here. A PUK somebody chooses is a PUK
                         that is written down and the same across a drawer of
                         tokens; letting a person pick a better one is a workaround
                         for the wrong problem. Blinky holds the value, spends it
                         on an unblock and replaces it, and nobody types it. -->

                    <Button x:Name="UnblockButton" Style="{StaticResource Action}" Click="Unblock_Click">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE785;" FontFamily="{StaticResource Icons}" FontSize="16"
                                       Foreground="{DynamicResource AccentText}" Margin="0,1,12,0" VerticalAlignment="Top" />
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold"
                                           Text="{Binding Path=[Tokens.Unblock], Source={x:Static local:Strings.Current}}" />
                                <TextBlock x:Name="UnblockStateText" Style="{StaticResource Hint}" Margin="0,3,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Button>

                    <!-- No management key here, deliberately. It is an operator's
                         secret, and nothing in this window can change it: the
                         person at the keyboard would be shown a warning they
                         cannot act on, which is how people learn to dismiss
                         warnings. It belongs in the console, and rotating it is
                         patch 0025. -->

                    <!-- Said out loud, always. A Bio with no finger enrolled used
                         to show nothing at all here, which reads as an ordinary
                         key and is the confusing case. -->
                    <Border CornerRadius="{StaticResource Radius}" Padding="12,10" Margin="0,8,0,0"
                            Background="{DynamicResource Background}"
                            BorderBrush="{DynamicResource Divider}" BorderThickness="1">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE928;" FontFamily="{StaticResource Icons}" FontSize="16"
                                       Foreground="{DynamicResource AccentText}" Margin="0,1,12,0" VerticalAlignment="Top" />
                            <StackPanel>
                                <TextBlock x:Name="BiometricText" FontSize="13" TextWrapping="Wrap" />
                                <TextBlock x:Name="BiometricDetailText" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Status bar: what the last action did, where BlinkyLite puts it. -->
        <Border Grid.Row="2"
                Background="{DynamicResource Panel}"
                BorderBrush="{DynamicResource Divider}"
                BorderThickness="0,1,0,0"
                Padding="20,10"
                MinHeight="40">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextMuted}" />
        </Border>
    </Grid>
</Window>
