<Window x:Class="Blinky.Agent.Ui.PinDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Blinky.Agent.Ui"
        Title="Blinky" Height="580" Width="470"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource Background}"
        Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="PasswordBox">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="MaxLength" Value="8" />
            <Setter Property="Background" Value="{DynamicResource FieldBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Text}" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="MinWidth" Value="110" />
            <Setter Property="Background" Value="{DynamicResource PanelRaised}" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{DynamicResource AccentSoft}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="26,22,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,4" />

        <TextBlock x:Name="RulesText" Grid.Row="1" Margin="0,0,0,16" TextWrapping="Wrap"
                   FontSize="12" Foreground="{DynamicResource TextMuted}" />

        <!-- The code to read down a telephone. Shown, not hidden: it is not a
             secret to the person holding the token, and it has to be read out
             character by character. -->
        <Border x:Name="ChallengePanel" Grid.Row="2" Visibility="Collapsed"
                CornerRadius="8" Padding="14,12" Margin="0,0,0,14"
                Background="{DynamicResource AccentSoft}">
            <StackPanel>
                <TextBlock x:Name="ChallengeLabel" FontSize="11"
                           Foreground="{DynamicResource TextMuted}" />
                <TextBox x:Name="ChallengeText" IsReadOnly="True" BorderThickness="0"
                         Background="Transparent" FontFamily="Consolas" FontSize="20"
                         Margin="0,6,0,0" Padding="0"
                         Foreground="{DynamicResource Accent}" />
            </StackPanel>
        </Border>

        <!-- The first field is the current PIN when changing, and the code an
             operator read back when unblocking offline. -->
        <TextBlock x:Name="FirstLabel" Grid.Row="3" Style="{StaticResource Label}"
                   Margin="0,0,0,4" />
        <PasswordBox x:Name="FirstBox" Grid.Row="3" Margin="0,22,0,14"
                     VerticalAlignment="Bottom" />

        <!-- A code being copied off a telephone call is typed wrong often
             enough that hiding it would be perverse: the person has to be able
             to see what they typed. -->
        <TextBox x:Name="CodeBox" Grid.Row="3" Visibility="Collapsed"
                 FontSize="16" FontFamily="Consolas" Padding="8,6" MaxLength="32"
                 Margin="0,22,0,14" VerticalAlignment="Bottom"
                 Background="{DynamicResource FieldBackground}"
                 Foreground="{DynamicResource Text}"
                 BorderBrush="{DynamicResource Divider}"
                 CaretBrush="{DynamicResource Text}" />

        <TextBlock x:Name="NewLabel" Grid.Row="4" Style="{StaticResource Label}" />
        <PasswordBox x:Name="NewBox" Grid.Row="5" PasswordChanged="Validate" />

        <TextBlock x:Name="RepeatLabel" Grid.Row="6" Style="{StaticResource Label}" />
        <PasswordBox x:Name="RepeatBox" Grid.Row="7" PasswordChanged="Validate" />

        <TextBlock x:Name="MessageText" Grid.Row="8" TextWrapping="Wrap" VerticalAlignment="Top"
                   Foreground="{DynamicResource Danger}" />

        <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Margin="0,0,10,0" IsCancel="True" Click="Cancel_Click"
                    Content="{Binding Path=[Pin.Cancel], Source={x:Static local:Strings.Current}}" />
            <Button x:Name="OkButton" IsDefault="True" Click="Ok_Click"
                    Background="{DynamicResource Accent}"
                    Foreground="{DynamicResource OnAccent}"
                    BorderBrush="{DynamicResource Accent}"
                    Content="{Binding Path=[Pin.Ok], Source={x:Static local:Strings.Current}}" />
        </StackPanel>
    </Grid>
</Window>
