<Window x:Class="Blinky.Agent.Ui.PinDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Blinky.Agent.Ui"
        Title="Blinky" Height="440" Width="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" ShowInTaskbar="True">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4" />

        <TextBlock Grid.Row="1" Margin="0,0,0,14" TextWrapping="Wrap" Opacity="0.75"
                   Text="{Binding Path=[Pin.Rules], Source={x:Static local:Strings.Current}}" />

        <!-- First field: the current PIN when changing, the PUK when unblocking.
             The label is the only difference between the two operations. -->
        <TextBlock x:Name="FirstLabel" Grid.Row="2" Margin="0,0,0,4" />
        <PasswordBox x:Name="FirstBox" Grid.Row="3" FontSize="16" Padding="6"
                     MaxLength="8" Margin="0,0,0,12" />

        <TextBlock Grid.Row="4" Margin="0,0,0,4"
                   Text="{Binding Path=[Pin.New], Source={x:Static local:Strings.Current}}" />
        <PasswordBox x:Name="NewBox" Grid.Row="5" FontSize="16" Padding="6"
                     MaxLength="8" Margin="0,0,0,12"
                     PasswordChanged="Validate" />

        <TextBlock Grid.Row="6" Margin="0,0,0,4"
                   Text="{Binding Path=[Pin.Repeat], Source={x:Static local:Strings.Current}}" />
        <PasswordBox x:Name="RepeatBox" Grid.Row="7" FontSize="16" Padding="6"
                     MaxLength="8" VerticalAlignment="Top"
                     PasswordChanged="Validate" />

        <StackPanel Grid.Row="7" VerticalAlignment="Bottom" Margin="0,12,0,0">
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="#B00020" />
        </StackPanel>

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button x:Name="CancelButton" Width="110" Margin="0,0,8,0"
                    IsCancel="True" Click="Cancel_Click"
                    Content="{Binding Path=[Pin.Cancel], Source={x:Static local:Strings.Current}}" />
            <Button x:Name="OkButton" Width="110" IsDefault="True" Click="Ok_Click"
                    Content="{Binding Path=[Pin.Ok], Source={x:Static local:Strings.Current}}" />
        </StackPanel>
    </Grid>
</Window>
