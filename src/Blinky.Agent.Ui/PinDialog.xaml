<Window x:Class="Blinky.Agent.Ui.PinDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Blinky.Agent.Ui"
        Title="Blinky" Width="540" SizeToContent="Height"
        Icon="Assets/blinky-agent.ico"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource Background}"
        Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI"
        FontSize="15">

    <Window.Resources>
        <!-- Big, as BlinkyLite's PIN window: the person typing here is
             usually not at ease with it, and a PIN mistyped costs an attempt. -->
        <Style TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="MaxLength" Value="8" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <Image DockPanel.Dock="Left" Source="Assets/blinky-agent-256.png" Width="32" Height="32"
                   Margin="0,0,12,0" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock x:Name="TitleText" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"
                       VerticalAlignment="Center" />
        </DockPanel>

        <TextBlock x:Name="RulesText" Grid.Row="1" Margin="0,12,0,20" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextMuted}" />

        <!-- The code to read down a telephone. Shown, not hidden: it is not a
             secret to the person holding the token, and it has to be read out
             character by character. -->
        <Border x:Name="ChallengePanel" Grid.Row="2" Visibility="Collapsed"
                CornerRadius="{StaticResource Radius}" Padding="14,12" Margin="0,0,0,18"
                Background="{DynamicResource AccentSoft}">
            <StackPanel>
                <TextBlock x:Name="ChallengeLabel" Style="{StaticResource Hint}" />
                <TextBox x:Name="ChallengeText" IsReadOnly="True" BorderThickness="0"
                         Background="Transparent" FontFamily="{StaticResource Mono}" FontSize="22"
                         Margin="0,6,0,0" Padding="0" MinHeight="0"
                         Foreground="{DynamicResource AccentText}" />
            </StackPanel>
        </Border>

        <!-- The first field is the current PIN when changing, and the code an
             operator read back when unblocking offline. -->
        <StackPanel Grid.Row="3">
            <TextBlock x:Name="FirstLabel" Style="{StaticResource FieldLabel}" />
            <PasswordBox x:Name="FirstBox" />

            <!-- A code being copied off a telephone call is typed wrong often
                 enough that hiding it would be perverse: the person has to be
                 able to see what they typed. -->
            <TextBox x:Name="CodeBox" Visibility="Collapsed"
                     TextChanged="CodeBox_TextChanged"
                     FontSize="20" FontFamily="{StaticResource Mono}" Padding="10,8" MaxLength="32"
                     Margin="0,0,0,16" />
        </StackPanel>

        <StackPanel Grid.Row="4">
            <TextBlock x:Name="NewLabel" Style="{StaticResource FieldLabel}" />
            <PasswordBox x:Name="NewBox" PasswordChanged="Validate" />

            <TextBlock x:Name="RepeatLabel" Style="{StaticResource FieldLabel}" />
            <PasswordBox x:Name="RepeatBox" PasswordChanged="Validate" />
        </StackPanel>

        <TextBlock x:Name="MessageText" Grid.Row="5" TextWrapping="Wrap" MinHeight="40"
                   Foreground="{DynamicResource Danger}" />

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CancelButton" MinWidth="120" Padding="12,8" Margin="0,0,12,0"
                    IsCancel="True" Click="Cancel_Click"
                    Content="{Binding Path=[Pin.Cancel], Source={x:Static local:Strings.Current}}" />
            <Button x:Name="OkButton" Style="{StaticResource Primary}" MinWidth="140" Padding="12,8"
                    IsDefault="True" Click="Ok_Click"
                    Content="{Binding Path=[Pin.Ok], Source={x:Static local:Strings.Current}}" />
        </StackPanel>
    </Grid>
</Window>
