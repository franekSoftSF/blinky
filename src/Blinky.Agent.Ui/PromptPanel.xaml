<UserControl x:Class="Blinky.Agent.Ui.PromptPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- One prompt, wherever it is shown: alone in the small window when no
         job is running, inside the issuance window when one is (0084a). The
         rules about PIN length, attempts, FIDO2 and the provisional PIN live
         here once rather than in each window. -->
    <StackPanel>
        <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />

        <TextBlock x:Name="MessageText" TextWrapping="Wrap"
                   Margin="0,8,0,16" Foreground="{DynamicResource TextMuted}" />

        <PasswordBox x:Name="PinBox" FontSize="20" Padding="10,8"
                     MaxLength="8" KeyDown="PinBox_KeyDown" />

        <!-- A palette role, not the #B00020 it was: that red was the one
             colour in this project no theme could reach, and on the dark
             background it was all but unreadable. -->
        <TextBlock x:Name="AttemptsText" Margin="0,10,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource Danger}" />

        <StackPanel x:Name="Buttons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="CancelButton" MinWidth="120" Padding="12,8" Margin="0,0,12,0"
                    Click="Cancel_Click" IsCancel="True" />
            <Button x:Name="OkButton" Style="{StaticResource Primary}" MinWidth="140" Padding="12,8"
                    Click="Ok_Click" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</UserControl>
