{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Connector": {
    "ListenUrl": "https://0.0.0.0:8444",
    "RequestTimeoutSeconds": 60,
    "AllowedClientThumbprints": [],
    "AllowedTemplates": [],
    "ServerCertificate": {}
  }
}
