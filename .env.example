# Copy to .env and change the password if this is not a laptop.
POSTGRES_DB=blinky
POSTGRES_USER=blinky
POSTGRES_PASSWORD=blinky

# There is no enrolment token here any more (0102). A token is a row made from
# the console - Administracja / Zetony - with a term, a number of machines it
# may enrol and a purpose, and it can be withdrawn in a second. A value in this
# file was the same secret for every machine for the life of the deployment,
# and it stayed valid wherever it had been pasted.

# Stands in for an operator signing in, until RBAC arrives in patch 0053.

# Host ports. Console is browser traffic, agent is mTLS.
CONSOLE_PORT=8443
AGENT_PORT=9443

# Where the management-key master and the PUK key-encryption key live.
#
# Configuration is the default and means "in this file". Pkcs11 means a token
# computes with them and will not hand them out; the code is the same either
# way, so a real HSM later is a module path rather than a change to Blinky.
#
# Switching is not just this line: the keys have to be put into the token
# first, with tools/SecretsTool. docs/06-security.md has the procedure, and it
# matters which of import and generate you use if cards are already in the
# field.
SECRETS_PROVIDER=Configuration
PKCS11_MODULE=/usr/lib/softhsm/libsofthsm2.so
PKCS11_TOKEN_LABEL=blinky

# A file only the API's user can read. A PIN set here instead is exposed by
# exactly the means that make an environment secret worse than a file, which
# would move the problem rather than solve it.
PKCS11_PIN_FILE=
PKCS11_PIN=

# Which CA issues. BuiltIn is the CA this stack runs. Adcs is a Microsoft CA
# reached through Blinky.AdcsConnector on the CA server, whose enrolment agent
# key stays on that server - docs/15-adcs-connector.md. Anything else stops the
# API at start rather than quietly issuing from the built-in CA.
CA_BACKEND=BuiltIn

# Only read when CA_BACKEND=Adcs.
# Connector: this API connects to the connector on the CA server.
# ConnectorPolls: the connector connects to this API on 9443 and collects its calls,
# and nothing connects into the CA's network. The next four keys are then unused.
ADCS_TRANSPORT=Connector
# The connector's own certificate is not configured here either: it enrols with
# a connector enrolment token and the API records its fingerprint (0102).
ADCS_CONNECTOR_URL=
# SHA-256 of the connector's TLS certificate. A 40-digit value is the SHA-1
# thumbprint and is refused, because pinning it would pin nothing.
ADCS_CONNECTOR_FINGERPRINT=
# What this stack presents to the connector. It buys the enrolment agent's
# signature, so it is worth as much as that key: a file only the API's user can
# read, with its password in a second one rather than here.
ADCS_CLIENT_CERTIFICATE=/etc/blinky/certs/adcs-client.p12
ADCS_CLIENT_CERTIFICATE_PASSWORD_FILE=
# The template's name, not its display name. The two differ on every template
# anybody has renamed, and the CA answers the wrong one with a denial that does
# not say which it wanted.
ADCS_TEMPLATE_SMARTCARD_LOGON=
# The key algorithm cards are enrolled with, RSA2048 or ECCP256. Empty means any.
# A template on the default cryptography settings demands 2048 bits and denies
# a P-256 key as too short; the registration check says so before a card does.
ADCS_KEY_ALGORITHM=
# The domain half of DOMAIN\user, which a Microsoft CA issues on somebody's
# behalf by. Empty reads it from the directory's Configuration partition.
DIRECTORY_NETBIOS_DOMAIN=
# Connector: read Active Directory through the ADCS connector, as its service
# account with Kerberos, instead of binding from here with DIRECTORY_BIND_DN and a
# password. Needs CA_BACKEND=Adcs. Empty binds directly with the DIRECTORY_* above.
DIRECTORY_VIA=

# Passkey providers (Phase 7, docs/12). Leave both empty and nothing in the
# stack reaches a cloud. Set one and the api container needs egress to it.
#
# Entra: an app registration with the application permissions
# UserAuthenticationMethod.ReadWrite.All and User.Read.All, admin-consented.
# A certificate (PFX, or PEM with the key) is preferred; a secret file is for a lab.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_CERTIFICATE=
ENTRA_CLIENT_CERTIFICATE_PASSWORD_FILE=
ENTRA_CLIENT_SECRET_FILE=
# Okta: the URL users sign in at, custom domain included - a credential is bound
# to the domain it was created on. OAuthPrivateKeyJwt is a service app with
# okta.users.read and okta.users.manage and DPoP off; ApiToken is for a lab.
OKTA_ORG_URL=
OKTA_AUTH_MODE=OAuthPrivateKeyJwt
OKTA_CLIENT_ID=
OKTA_PRIVATE_KEY=
OKTA_KEY_ID=
OKTA_API_TOKEN_FILE=

# The first way in to the console. Generated by install-server.sh into a file
# only root can read; it buys exactly one sign-in, during which a real password
# is set and a second factor is enrolled. Leave it empty and nobody can sign in.
BOOTSTRAP_ADMIN_USERNAME=superadmin
BOOTSTRAP_ADMIN_PASSWORD=
