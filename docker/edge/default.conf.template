# Blinky edge.
#
# Two listeners on one container, because the two kinds of traffic want
# opposite things from a WAF:
#
#   8443  console  - browsers. Full CRS in blocking mode.
#   9443  agents   - mTLS. CRS in DetectionOnly, and no body inspection on the
#                    endpoints that carry DER and PKCS#10, because a rule set
#                    tuned for web forms will call a certificate request an
#                    attack.
#
# See docs/01-architecture.md.

# ---------------------------------------------------------------- console
server {
    listen 8443 ssl;
    http2 on;
    server_name _;

    # Docker's embedded DNS, named so nginx re-resolves the upstreams instead
    # of pinning the addresses it saw at startup. Without this, restarting the
    # api container leaves the edge pointing at an address nothing answers on,
    # and every request is a 502 until nginx is restarted too - a failure that
    # looks like the api being down long after it came back.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $api     http://api:8080;
    set $console http://console:8080;

    ssl_certificate     /etc/nginx/certs/edge.crt;
    ssl_certificate_key /etc/nginx/certs/edge.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    # The CRS image already loads the rule set at http level; repeating the
    # include here duplicates every rule id and nginx refuses to start.
    modsecurity on;

    # CRS 930120 (LFI) checks argument NAMES against lfi-os-files.data, and
    # that list contains the Unix dotfile `.profile`. A JSON field called
    # `profileName` arrives as ARGS_NAMES:json.profileName, the match is a
    # substring, and every certificate-profile request is a 403 - a rule about
    # reading /etc/passwd firing on a field name.
    #
    # One target removed from one rule, not the rule and not the endpoint:
    # ARGS (the values) stay inspected, so a profile name that really does try
    # to traverse a path is still caught.
    modsecurity_rules '
        SecRule REQUEST_URI "@rx ^/api/(jobs/enrol|credentials/issue)"             "id:9000200,phase:1,pass,nolog,             ctl:ruleRemoveTargetById=930120;ARGS_NAMES:json.profileName"
    ';

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;

    client_max_body_size 4m;

    # The CRS image's own container healthcheck asks for this. Without it the
    # log fills with 404s at every interval - noise that trains people to
    # ignore the log, which is worse than the missing endpoint.
    location = /healthz {
        access_log off;
        return 200 "ok
";
    }

    # The console and the API share one origin, which is the whole reason the
    # console is served from here rather than from its own port: no CORS, no
    # second certificate, and one place where the rule set sees everything.
    #
    # /health is the API's, and named here because it is the one endpoint of
    # the API's that does not live under /api. Left to the catch-all it would
    # be answered by the console with index.html and a 200 - which is worse
    # than a 404, because everything watching it would go on reporting healthy.
    location = /health {
        proxy_pass $api$request_uri;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        proxy_set_header X-Client-Verify "";
        proxy_set_header X-Client-Cert   "";
    }

    location /api/ {
        proxy_pass $api$request_uri;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        # A browser must never be able to claim an agent identity. These are
        # set to empty rather than left alone: proxy_set_header replaces
        # whatever the client sent.
        proxy_set_header X-Client-Verify "";
        proxy_set_header X-Client-Cert   "";
    }

    # Static files, and a router behind them. The console container answers
    # every path that is not /api with index.html, so a refresh on a deep link
    # is a page rather than a 404.
    location / {
        proxy_pass $console$request_uri;
        proxy_set_header Host            $host;
        proxy_set_header X-Real-IP       $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}

# ---------------------------------------------------------------- agents
server {
    listen 9443 ssl;
    http2 on;
    server_name _;

    # Docker's embedded DNS, named so nginx re-resolves the upstreams instead
    # of pinning the addresses it saw at startup. Without this, restarting the
    # api container leaves the edge pointing at an address nothing answers on,
    # and every request is a 502 until nginx is restarted too - a failure that
    # looks like the api being down long after it came back.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $api     http://api:8080;
    set $console http://console:8080;

    ssl_certificate     /etc/nginx/certs/edge.crt;
    ssl_certificate_key /etc/nginx/certs/edge.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # mTLS. The agent proves the machine here; the user proves themselves with
    # Kerberos inside the request. See docs/05-agent-protocol.md.
    #
    # "optional", not "on", for one reason: enrolment is the only endpoint an
    # agent can reach before it has a certificate, and "on" refuses the
    # handshake before the API ever sees the request. The verdict is forwarded
    # and the API refuses everything else without it - which is the stronger
    # check anyway, because only the database knows whether that certificate
    # still belongs to an agent that exists and is not suspended.
    ssl_client_certificate /etc/nginx/certs/agent-ca.crt;
    ssl_verify_client      optional;
    ssl_verify_depth       2;

    modsecurity on;
    # Detection only: on this listener a false positive is a broken enrolment,
    # and mTLS plus schema validation is the actual control.
    modsecurity_rules 'SecRuleEngine DetectionOnly';

    client_max_body_size 12m;

    # The CRS image's own container healthcheck asks for this. Without it the
    # log fills with 404s at every interval - noise that trains people to
    # ignore the log, which is worse than the missing endpoint.
    location = /healthz {
        access_log off;
        return 200 "ok
";
    }

    # A PKCS#10 request is base64 of DER, and a rule set tuned for web forms
    # reads that as an attack. Body inspection is turned off for the endpoints
    # that carry binary by design - URI and header rules still apply, and the
    # body is validated against a schema by the API. The client certificate is
    # the control here, not the rule set.
    #
    # Inline rather than a mounted rules file: the CRS image copies its own
    # config into /etc/modsecurity.d at startup and a bind mount inside that
    # tree breaks the copy.
    modsecurity_rules '
        SecRule REQUEST_URI "@rx ^/api/(credentials|agents/enroll|agents/[^/]+/renew-certificate)"             "id:9000100,phase:1,pass,nolog,ctl:requestBodyAccess=Off"
    ';

    # The doorbell. No body to inspect, and buffering would defeat it.
    location /hubs/ {
        modsecurity off;

        proxy_pass $api$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host       $host;
        proxy_buffering off;
        proxy_read_timeout 3600s;

        proxy_set_header X-Client-Verify $ssl_client_verify;
        proxy_set_header X-Client-Cert   $ssl_client_escaped_cert;
    }

    location / {
        proxy_pass $api$request_uri;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-Proto https;

        # nginx sets these; anything the client sent is overwritten.
        proxy_set_header X-Client-Verify $ssl_client_verify;
        proxy_set_header X-Client-Cert   $ssl_client_escaped_cert;
    }
}
